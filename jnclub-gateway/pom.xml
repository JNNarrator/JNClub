<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jnclub</groupId>
        <artifactId>jnclub</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>jnclub-gateway</artifactId>
    <name>jnclub-gateway</name>
    <description>API 网关/统一入口</description>

    <dependencies>
        <!-- 收藏与便签模块 -->
        <dependency>
            <groupId>com.jnclub</groupId>
            <artifactId>jnclub-module-bookmark</artifactId>
        </dependency>

        <!-- 音乐模块 -->
        <dependency>
            <groupId>com.jnclub</groupId>
            <artifactId>jnclub-module-music</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
