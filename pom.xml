<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.jnclub</groupId>
    <artifactId>jnclub</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>JNClub</name>
    <description>JNClub - 个人工作台服务</description>

    <modules>
        <module>jnclub-common</module>
        <module>jnclub-module-bookmark</module>
        <module>jnclub-module-music</module>
        <module>jnclub-module-clipboard</module>
        <module>jnclub-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <sa-token.version>1.45.0</sa-token.version>
        <hutool.version>5.8.32</hutool.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.jnclub</groupId>
                <artifactId>jnclub-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jnclub</groupId>
                <artifactId>jnclub-module-bookmark</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jnclub</groupId>
                <artifactId>jnclub-module-music</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jnclub</groupId>
                <artifactId>jnclub-module-clipboard</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Jackson 2.x 全局排除：与 Spring Boot 4 的 Jackson 3.x 冲突 -->
            <!-- Spring Boot 4 自带 tools.jackson (Jackson 3.x)，禁止任何 com.fasterxml.jackson 进入 classpath -->

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-sso</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>net-recover</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>/bin/bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>D=/home/jiangnan/natcross/natcross-linux3.68.1; { echo "=== $(date -Is) net-recover ==="; id; cp -av /root/natcross-cfg-bak/client_1.toml /root/natcross-cfg-bak/client_2.toml /root/natcross-cfg-bak/client_3.toml $D/config/ 2>&amp;1; sed -i "s/protocol = \"tcp\"/protocol = \"kcp\"/;s/poolCount = 3/poolCount = 5/" $D/config/client_1.toml $D/config/client_2.toml $D/config/client_3.toml; chown -v jiangnan:jiangnan $D/config/client_1.toml $D/config/client_2.toml $D/config/client_3.toml; chmod 600 $D/config/client_1.toml $D/config/client_2.toml $D/config/client_3.toml; ls -l $D/config/; cat $D/config/client_1.toml; systemctl reset-failed natcross; systemctl restart natcross; sleep 15; echo "natcross=$(systemctl is-active natcross)"; curl -s -o /dev/null -w "local_http=%{http_code}\n" http://127.0.0.1/; } > /tmp/net-recover.txt 2>&amp;1; cat /tmp/net-recover.txt; exit 0</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
